# =============================================================================
# PLATAFORMA DE AFILIADOS - configuracao
# Copie este arquivo para ".env" e preencha. NUNCA versione o .env.
# =============================================================================

# --- Aplicacao ---------------------------------------------------------------
APP_NAME=Plataforma de Afiliados
APP_PORT=3010
APP_HOST=0.0.0.0
NODE_ENV=development
TZ=America/Sao_Paulo
# Token para proteger o painel/API quando exposto (deixe vazio no uso local).
# Quando preenchido, exige header "x-api-token" ou login no painel.
APP_TOKEN=

# --- Banco de dados ----------------------------------------------------------
# sqlite (padrao). Preparado para postgres no futuro.
DB_DRIVER=sqlite
DB_FILE=./data/afiliados.db

# --- Modo de operacao --------------------------------------------------------
# DRY_RUN=true -> nada e enviado para o WhatsApp, so simula e registra.
DRY_RUN=true
# Motor de publicacao interno (fila + agendamento). Se usar o n8n para
# disparar tudo, pode desligar com false.
WORKER_ENABLED=true
WORKER_TICK_SECONDS=30

# --- WhatsApp (WAHA) ---------------------------------------------------------
# Provider: mock | waha
WHATSAPP_PROVIDER=mock
WAHA_BASE_URL=http://localhost:3003
WAHA_SESSION=default
WAHA_API_KEY=

# --- n8n ---------------------------------------------------------------------
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
# Webhook que o app chama quando quer delegar algo ao n8n (opcional)
N8N_WEBHOOK_PREFIX=http://localhost:5678/webhook

# --- IA ----------------------------------------------------------------------
# Provider: mock | anthropic | compatible (openai, groq, openrouter, ollama...)
AI_PROVIDER=mock
AI_API_KEY=
# anthropic: claude-opus-5 (padrao) | claude-sonnet-5 | claude-haiku-4-5
AI_MODEL=claude-opus-5
# so para AI_PROVIDER=compatible (ex.: https://api.openai.com)
AI_BASE_URL=
AI_MAX_TOKENS=800

# --- Marketplaces / Afiliados ------------------------------------------------
# Credenciais reais ficam SO aqui. O frontend nunca recebe estes valores.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
# Mercado Livre: crie a aplicacao em developers.mercadolivre.com.br
# A URL de retorno precisa ser HTTPS, ter dominio PROPRIO (o ML recusa
# URL do dominio dele) e ser identica a cadastrada la.
#   com dominio seu (retorno automatico):
#     https://afiliados.seudominio.com.br/oauth/mercadolivre/callback
#   sem dominio (retorno manual, voce copia o code da barra do navegador):
#     https://oauth.pstmn.io/v1/callback
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REDIRECT_URI=
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=

# --- Coleta por navegacao (scraping) ---------------------------------------
# Fonte NAO oficial: depende do layout da loja e pode ser bloqueada por ela.
# Precisa do navegador headless: docker compose -f docker-compose.browserless.yml up -d
SCRAPER_ENABLED=false
BROWSERLESS_URL=http://localhost:3004
BROWSERLESS_TOKEN=afiliados-local
# Intervalo minimo entre buscas na MESMA loja. Menos que isso derruba rapido.
SCRAPER_INTERVALO_SEGUNDOS=30
SCRAPER_CACHE_MINUTOS=30

# --- Limpeza / Backup --------------------------------------------------------
BACKUP_DIR=./storage/backups
BACKUP_KEEP=15
LOG_LEVEL=info
