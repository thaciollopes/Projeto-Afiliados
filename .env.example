# =============================================================================
# PLATAFORMA DE AFILIADOS - configuracao
# Copie este arquivo para ".env" e preencha. NUNCA versione o .env.
# =============================================================================

# --- Aplicacao ---------------------------------------------------------------
APP_NAME=Plataforma de Afiliados
APP_PORT=3010
APP_HOST=0.0.0.0
NODE_ENV=development
TZ=America/Sao_Paulo
# Token para proteger o painel/API quando exposto (deixe vazio no uso local).
# Quando preenchido, exige header "x-api-token" ou login no painel.
APP_TOKEN=

# --- Banco de dados ----------------------------------------------------------
# sqlite (padrao). Preparado para postgres no futuro.
DB_DRIVER=sqlite
DB_FILE=./data/afiliados.db

# --- Modo de operacao --------------------------------------------------------
# DRY_RUN=true -> nada e enviado para o WhatsApp, so simula e registra.
DRY_RUN=true
# Motor de publicacao interno (fila + agendamento). Se usar o n8n para
# disparar tudo, pode desligar com false.
WORKER_ENABLED=true
WORKER_TICK_SECONDS=30

# --- WhatsApp (WAHA) ---------------------------------------------------------
# Provider: mock | waha
WHATSAPP_PROVIDER=mock
WAHA_BASE_URL=http://localhost:3003
WAHA_SESSION=default
WAHA_API_KEY=
# Mostra "digitando..." 2 a 6 s antes de cada post (parece gente, nao robo).
WHATSAPP_DIGITANDO=true
# Converter link pelo WhatsApp: mande um link de produto no PRIVADO do numero de
# divulgacao e receba o post pronto com o seu link de afiliado.
# Chave = a mesma de WHATSAPP_HOOK_HMAC_KEY no docker-compose.waha.yml.
# Vazio = desligado. Numeros autorizados: so eles recebem resposta (com DDI).
WHATSAPP_WEBHOOK_CHAVE=
WHATSAPP_NUMEROS_AUTORIZADOS=5511999999999
# Para onde a WAHA (no Docker) manda as mensagens. Deixe vazio para desligar.
WAHA_HOOK_URL=
# WAHA_HOOK_URL=http://host.docker.internal:3010/api/whatsapp/webhook

# --- Telegram (opcional) --------------------------------------------------------
# Crie o bot no @BotFather, cole o token e adicione o bot como ADMIN do canal.
# No cadastro do canal: provider "telegram", identificador "@seucanal" ou "-100...".
TELEGRAM_BOT_TOKEN=

# --- n8n ---------------------------------------------------------------------
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
# Webhook que o app chama quando quer delegar algo ao n8n (opcional)
N8N_WEBHOOK_PREFIX=http://localhost:5678/webhook

# --- IA ----------------------------------------------------------------------
# Provider: mock | anthropic | compatible (openai, groq, openrouter, ollama...)
AI_PROVIDER=mock
AI_API_KEY=
# anthropic: claude-opus-5 (padrao) | claude-sonnet-5 | claude-haiku-4-5
AI_MODEL=claude-opus-5
# so para AI_PROVIDER=compatible (ex.: https://api.openai.com)
AI_BASE_URL=
AI_MAX_TOKENS=800

# --- Lojas / Afiliados --------------------------------------------------------
# Nenhuma credencial de API aqui: o sistema trabalha com o seu cookie e a sua tag,
# colocados na tela LOJAS do painel (ficam no banco local, nunca no .env).

# --- Envio pelo WhatsApp -------------------------------------------------------
# Pausa aleatoria entre dois envios de verdade (anti-bloqueio). Com varios grupos
# numa campanha, os posts saem espalhados em vez de todos no mesmo segundo.
ENVIO_PAUSA_MIN_SEGUNDOS=25
ENVIO_PAUSA_MAX_SEGUNDOS=75

# --- Limpeza / Backup --------------------------------------------------------
BACKUP_DIR=./storage/backups
BACKUP_KEEP=15
LOG_LEVEL=info
