{
  "name": "afiliados-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de automacao de ofertas e afiliados (produtos, promocoes, cupons, campanhas, WhatsApp/WAHA, n8n)",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "reset": "node scripts/reset.js",
    "backup": "node scripts/backup.js",
    "health": "node scripts/health.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:painel": "node --test \"tests/painel.test.js\""
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "jsdom": "^27.0.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.2.0"
  }
}
