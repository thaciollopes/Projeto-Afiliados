{
  "name": "AFILIADOS 01 - Processar fila de publicacao",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 5 }] }
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "A cada 5 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-200, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AFILIADOS_API || 'http://host.docker.internal:3010' }}/api/publicacoes/processar",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"limite\": 10}",
        "options": { "timeout": 60000 }
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Processar fila",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [40, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            {
              "leftValue": "={{ $json.erros }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Teve erro?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [280, 0]
    },
    {
      "parameters": {
        "jsCode": "// Aqui voce pluga o aviso que preferir (Telegram, e-mail, WhatsApp).\n// O app ja registra tudo em SISTEMA > Logs e em PUBLICACOES > Historico.\nfor (const item of $input.all()) {\n  console.log('[AFILIADOS] erros na fila:', JSON.stringify(item.json.detalhes || []));\n}\nreturn $input.all();"
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Avisar (personalize)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, -80]
    }
  ],
  "connections": {
    "A cada 5 minutos": { "main": [[{ "node": "Processar fila", "type": "main", "index": 0 }]] },
    "Processar fila": { "main": [[{ "node": "Teve erro?", "type": "main", "index": 0 }]] },
    "Teve erro?": { "main": [[{ "node": "Avisar (personalize)", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "tags": []
}
